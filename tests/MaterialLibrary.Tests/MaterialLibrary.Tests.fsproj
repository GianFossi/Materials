<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>MaterialLibrary.Tests</AssemblyName>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Tests.fs" />
    <Compile Include="Native2025Tests.fs" />
    <Compile Include="XmlPhysicalImportTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MaterialLibrary/MaterialLibrary.fsproj" />
    <ProjectReference Include="../../src/MaterialLibrary.Crud/MaterialLibrary.Crud.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FSharp.Core" Version="11.0.100" />
  </ItemGroup>

</Project>
