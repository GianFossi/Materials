<?xml version="1.0" encoding="utf-8"?>
<LibraryConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <ConfigurationVersion>1.0.0</ConfigurationVersion>
  <General>
    <EnableDiagnostics>false</EnableDiagnostics>
    <StrictValidation>true</StrictValidation>
    <DefaultMaterialId />
  </General>
  <Interpolation>
    <SpecificHeat>
      <Mode>Linear</Mode>
      <LagrangeDegree>3</LagrangeDegree>
      <ExtrapolateFlat>false</ExtrapolateFlat>
    </SpecificHeat>
    <StressStrain>
      <Mode>Linear</Mode>
      <LagrangeDegree>3</LagrangeDegree>
      <ExtrapolateFlat>false</ExtrapolateFlat>
    </StressStrain>
    <CreepTable>
      <Mode>Linear</Mode>
      <LagrangeDegree>3</LagrangeDegree>
      <ExtrapolateFlat>false</ExtrapolateFlat>
    </CreepTable>
    <StressRupture>
      <Mode>Linear</Mode>
      <LagrangeDegree>3</LagrangeDegree>
      <ExtrapolateFlat>false</ExtrapolateFlat>
    </StressRupture>
    <Fatigue>
      <Mode>Linear</Mode>
      <LagrangeDegree>3</LagrangeDegree>
      <ExtrapolateFlat>false</ExtrapolateFlat>
    </Fatigue>
  </Interpolation>
  <Creep>
    <NortonA>1E-12</NortonA>
    <NortonN>3</NortonN>
    <NortonM>0.3</NortonM>
    <GarofaloA>1E-10</GarofaloA>
    <GarofaloN>2</GarofaloN>
    <GarofaloM>0.4</GarofaloM>
    <GarofaloAlpha>0.01</GarofaloAlpha>
    <KachanovA1>5E-11</KachanovA1>
    <KachanovN1>2</KachanovN1>
    <KachanovM1>1.5</KachanovM1>
    <KachanovA2>1E-08</KachanovA2>
    <KachanovN2>1</KachanovN2>
    <KachanovM2>2</KachanovM2>
    <KachanovTimeSteps>100</KachanovTimeSteps>
    <KachanovTotalHours>1000</KachanovTotalHours>
  </Creep>
  <Io>
    <DataFolder>./data</DataFolder>
    <ExportFolder>./export</ExportFolder>
    <AutoCreateFolders>true</AutoCreateFolders>
    <MaterialDatabaseFolder>C:\Users\ganfossi\Documents\DataBase\data</MaterialDatabaseFolder>
    <AsmeMaterialDatabaseFile>asme_materials.db</AsmeMaterialDatabaseFile>
    <EnMaterialDatabaseFile>en_materials.db</EnMaterialDatabaseFile>
  </Io>
</LibraryConfiguration>