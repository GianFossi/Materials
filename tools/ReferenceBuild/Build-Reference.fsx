// Author: Claude
// Last revision: 2026-11-01
// Purpose: Build the shipped reference database (materials_2025.db) from the generated ASME import plus the physical-property XML that needs no manual review.
//
// Steps (all on temporary files; the output is written only when every check passes):
//   1. take the database freshly generated by MaterialLibrary.DatabaseUpdater from database/sources (--generated);
//   2. copy it to a temporary .working.db and import, through the project's own importer, the XML records that
//      - do not require manual review (RequiresReview = false), have numeric points and are not external-pressure charts,
//      - have exactly one candidate per (material, family);
//      no review is ever declared (Reviewed = false);
//   3. copy only the resulting data and provenance tables into a clean copy of the generated database, so the reference carries no
//      editor tables, hardening objects or journals (those exist only in working copies);
//   4. VACUUM, PRAGMA integrity_check, PRAGMA foreign_key_check, then write the result and a short summary (--summary, JSON).
// Options: --generated <db> --data <database/data folder> --output <db> --summary <json> [--force]
// Run it through tools/Build-Reference.ps1, which also runs the DatabaseUpdater and builds the project into tools/ReferenceBuild/bin.
// Units: temperatures degC, stresses MPa, sizes mm.

#r "bin/MaterialLibrary.dll"
#r "bin/MaterialLibrary.Crud.dll"
#r "nuget: Microsoft.Data.Sqlite, 10.0.13"

open System
open System.IO
open System.Security.Cryptography
open System.Text.Json
open Microsoft.Data.Sqlite
open MaterialLibrary.Crud

let args = fsi.CommandLineArgs |> Array.skip 1
let option name = args |> Array.tryFindIndex ((=) name) |> Option.bind (fun i -> if i + 1 < args.Length then Some args[i + 1] else None)
let required name = option name |> Option.defaultWith (fun () -> failwithf "Missing option %s" name) |> Path.GetFullPath
let generated, dataRoot, output, summaryPath = required "--generated", required "--data", required "--output", required "--summary"
let force = args |> Array.contains "--force"
if File.Exists output && not force then failwithf "%s already exists: use --force to replace the shipped reference." output

let temp = Path.Combine(Path.GetTempPath(), "reference-build-" + Guid.NewGuid().ToString("N"))
Directory.CreateDirectory temp |> ignore
let workPath = Path.Combine(temp, "import.working.db")
let finalPath = Path.Combine(temp, "materials_2025.db")
File.Copy(generated, workPath)
File.Copy(generated, finalPath)

/// <summary>Open a read-write connection with foreign keys on.</summary>
let connect (path: string) =
    let db = new SqliteConnection(SqliteConnectionStringBuilder(DataSource = path, Mode = SqliteOpenMode.ReadWrite, Pooling = false, ForeignKeys = Nullable true).ConnectionString)
    db.Open()
    db

/// <summary>Execute a statement and return the first cell.</summary>
let scalar (db: SqliteConnection) (sql: string) =
    use command = db.CreateCommand()
    command.CommandText <- sql
    command.ExecuteScalar()

let exec (db: SqliteConnection) (sql: string) =
    use command = db.CreateCommand()
    command.CommandText <- sql
    command.ExecuteNonQuery() |> ignore

// ---- 2. import the XML that needs no manual review
let records =
    [ for folder in [ "physical-properties-xml"; "external-pressure-xml" ] do
        let r, e = XmlPropertyReader.readFolder (Path.Combine(dataRoot, folder))
        if e.Length > 0 then failwithf "Unreadable XML: %A" e
        yield! r ]
    |> List.toArray
let byKey = records |> Array.map (fun r -> r.Key, r) |> dict
let proposals, needReview =
    use db = connect workPath
    let all = XmlPropertyMatching.propose db records
    all |> Array.filter (fun p -> not byKey[p.RecordKey].RequiresReview), all |> Array.filter (fun p -> byKey[p.RecordKey].RequiresReview)
let candidates = proposals |> Array.filter (fun p -> p.PropertyCode <> "EP" && byKey[p.RecordKey].Points.Length > 0)
let unique = candidates |> Array.groupBy (fun p -> p.MaterialId, p.PropertyCode) |> Array.filter (fun (_, ps) -> ps.Length = 1) |> Array.map (fun (_, ps) -> ps[0])
let assignments =
    use db = connect workPath
    unique |> Array.map (fun p ->
        let r = byKey[p.RecordKey]
        { MaterialId = p.MaterialId; Record = r; Reviewed = false; ReplaceExisting = false; ExpectedVersion = XmlPropertyImport.version db p.MaterialId r.PropertyCode })
match XmlPropertyImport.apply workPath assignments with
| Ok n -> printfn "Imported %d associations (%d proposals need review and were not imported)" n needReview.Length
| Error e -> failwithf "Import failed: %s" e

// ---- 3. copy data and provenance into the clean database
do
    use db = connect finalPath
    exec db (sprintf "ATTACH DATABASE '%s' AS w" (workPath.Replace("'", "''")))
    for name in [ "Xml_Import_Documents"; "Xml_Property_Associations"; "Xml_Import_History" ] do
        exec db (string (scalar db (sprintf "SELECT sql FROM w.sqlite_master WHERE type='table' AND name='%s'" name)))
    exec db "BEGIN"
    for t in [ "Physical_Properties"; "Physical_Property_Values"; "Extension"; "Xml_Import_Documents"; "Xml_Property_Associations" ] do
        exec db (sprintf "INSERT INTO main.\"%s\" SELECT * FROM w.\"%s\"" t t)
    let count = scalar db "SELECT COUNT(*) FROM Xml_Property_Associations"
    exec db (sprintf "INSERT OR REPLACE INTO Database_Metadata(Key,Value) VALUES('PhysicalXmlImport','%s associations from database/data/physical-properties-xml: records without manual review and with a single candidate per material and family; Code Case records needing review and the raw external-pressure extractions are not imported')" (string count))
    exec db "COMMIT"
    exec db "DETACH DATABASE w"
    exec db "VACUUM"
    // ---- 4. checks
    let integrity = string (scalar db "PRAGMA integrity_check")
    if integrity <> "ok" then failwithf "integrity_check: %s" integrity
    use fk = db.CreateCommand()
    fk.CommandText <- "PRAGMA foreign_key_check"
    use reader = fk.ExecuteReader()
    if reader.Read() then failwith "foreign_key_check reported violations"
SqliteConnection.ClearAllPools()

let count (sql: string) = use db = connect finalPath in Convert.ToInt64(scalar db sql)
let sha = Convert.ToHexString(SHA256.HashData(File.ReadAllBytes finalPath)).ToLowerInvariant()
let summary =
    dict [ "database_file", box (sprintf "database/data/%s" (Path.GetFileName output)); "database_sha256", box sha
           "main_materials", box (count "SELECT COUNT(*) FROM Main"); "mechanical_curves", box (count "SELECT COUNT(*) FROM Material_Properties")
           "mechanical_values", box (count "SELECT COUNT(*) FROM Property_Values"); "regulatory_materials", box (count "SELECT COUNT(*) FROM ASME_Data")
           "regulatory_source_fields_verified", box (count "SELECT COUNT(*) FROM ASME_Data_Source"); "note_documents_verified", box (count "SELECT COUNT(*) FROM Source_Documents")
           "full_note_texts_verified", box (count "SELECT COUNT(*) FROM Source_Notes"); "physical_xml_associations", box (count "SELECT COUNT(*) FROM Xml_Property_Associations")
           "physical_property_values", box (count "SELECT COUNT(*) FROM Physical_Property_Values"); "xml_proposals_needing_review_not_imported", box needReview.Length
           "integrity_check", box "ok"; "foreign_key_check", box "ok" ]
File.WriteAllText(summaryPath, JsonSerializer.Serialize(summary, JsonSerializerOptions(WriteIndented = true)))
Directory.CreateDirectory(Path.GetDirectoryName output) |> ignore
File.Copy(finalPath, output, true)
printfn "Written %s (%.1f MB) sha256 %s" output (float (FileInfo(output).Length) / 1e6) sha
try Directory.Delete(temp, true) with _ -> ()
