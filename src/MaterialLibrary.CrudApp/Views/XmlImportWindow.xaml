<Window x:Class="MaterialLibraryCrudApp.Views.XmlImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import XML — Review and Match Properties"
        Width="1450"
        Height="950"
        MinWidth="1100"
        MinHeight="750">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Physical Properties and External-Pressure Charts — XML Import"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Choose an XML folder and review the parsed records. Match each record to the correct material, check the preview and units, then explicitly select the associations to import."
                       TextWrapping="Wrap"
                       Foreground="#52616F"
                       Margin="0,0,0,8" />
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right"
                        Content="Choose folder..."
                        Command="{Binding PickFolderCommand}"
                        Padding="12,5"
                        ToolTip="Choose the folder containing XML files. Its subfolders are scanned too." />
                <Button DockPanel.Dock="Right"
                        Content="Scan XML"
                        Command="{Binding ScanCommand}"
                        Padding="12,5"
                        Margin="6,0"
                        ToolTip="Read XML files in the selected folder and list records and parsing diagnostics." />
                <TextBox Text="{Binding Folder,UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Folder scanned recursively for physical-property or external-pressure XML files." />
            </DockPanel>
            <TextBlock Text="{Binding Diagnostic}"
                       TextWrapping="Wrap"
                       Foreground="#9A3412"
                       Margin="0,8" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding Status}"
                   TextWrapping="Wrap"
                   Margin="0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Records}"
                     SelectedItem="{Binding SelectedRecord}"
                     ToolTip="Parsed source records. Select one to inspect its values, match candidates, and preview the data.">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding PropertyCode}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Key}" FontSize="10" Foreground="Gray" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="280" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="Property family" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Families}"
                                  SelectedItem="{Binding PropertyCode}"
                                  Width="170"
                                  Margin="6,0"
                                  ToolTip="Select the physical-property family represented by the source record." />
                        <TextBlock Text="{Binding Unit}" VerticalAlignment="Center" />
                        <CheckBox Content="Constant density/Poisson ratio"
                                  IsChecked="{Binding IsConstant}"
                                  Margin="14,0"
                                  VerticalAlignment="Center"
                                  ToolTip="Store a single density or Poisson-ratio value in the material extension instead of a temperature-dependent curve." />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="Source composition" VerticalAlignment="Center" />
                        <TextBox Text="{Binding SourceComposition,UpdateSourceTrigger=PropertyChanged}"
                                 Width="190" Margin="6,0"
                                 ToolTip="Composition reported by the XML source; used as supporting evidence when matching materials." />
                        <TextBlock Text="UNS" VerticalAlignment="Center" />
                        <TextBox Text="{Binding SourceUns,UpdateSourceTrigger=PropertyChanged}"
                                 Width="120" Margin="6,0"
                                 ToolTip="UNS identifier reported by the source record, if available." />
                        <TextBlock Text="Chart" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ChartName,UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" Margin="6,0"
                                 ToolTip="External-pressure chart identifier, such as CS-1. Leave blank for ordinary physical-property records." />
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="Find material matches"
                                Command="{Binding MatchCommand}"
                                Padding="10,5"
                                Margin="0,0,6,0"
                                ToolTip="Calculate candidate material matches using identity, UNS, composition, and chart evidence." />
                        <Button Content="Select unambiguous matches"
                                Command="{Binding SelectAutomaticCommand}"
                                Padding="10,5"
                                Margin="0,0,6,0"
                                ToolTip="Select only high-confidence, unambiguous candidates. Review them before importing." />
                        <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged,Delay=300}"
                                 Width="230"
                                 ToolTip="Filter candidate materials by identity, composition, or the match explanation." />
                    </WrapPanel>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TabControl>
                        <TabItem Header="Editable Numeric Data">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom"
                                        Content="Update preview"
                                        Command="{Binding PreviewCommand}"
                                        Padding="10,5"
                                        ToolTip="Parse the edited rows and refresh the graph without writing to the database." />
                                <TextBox Text="{Binding NumericText,UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         ToolTip="Enter SI values as T value, or external-pressure chart rows as T A B. Separate columns with a tab, space, or semicolon; use a period for decimal values." />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Original Text/XML">
                            <TextBox Text="{Binding SourceText,Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     ToolTip="Read-only source text and XML for the selected record." />
                        </TabItem>
                    </TabControl>
                    <DockPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Preview: blue shows the XML record; gray shows existing database values. External-pressure charts use a logarithmic A axis and separate lines for each temperature."
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="PlotLegend"
                                   DockPanel.Dock="Bottom"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <Canvas x:Name="Plot"
                                Background="#F4F7FB"
                                ClipToBounds="True"
                                SizeChanged="Plot_SizeChanged"
                                ToolTip="Visual comparison between the incoming XML data and the selected material's existing curve." />
                    </DockPanel>
                </Grid>
                <DockPanel Grid.Row="2">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <CheckBox Content="I verified the record, units, notes, curve, and any PDF exponents"
                                  IsChecked="{Binding Reviewed}"
                                  ToolTip="Required confirmation for manually entered or raw-extracted data. Verify the source and numerical interpretation before importing." />
                        <CheckBox Content="Explicitly replace existing data for the same family/chart association"
                                  IsChecked="{Binding ReplaceExisting}"
                                  Margin="0,5"
                                  ToolTip="Allow selected imports to replace an existing curve or chart association. Leave unchecked to avoid replacing existing data." />
                        <Button Content="Import selected associations..."
                                Command="{Binding ImportCommand}"
                                HorizontalAlignment="Left"
                                Padding="16,7"
                                ToolTip="Import the selected record into the checked materials after validation and confirmation." />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Targets}"
                              SelectedItem="{Binding SelectedTarget}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              ToolTip="Review candidate identities and match evidence. Use the Import checkbox to select each destination material.">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Import" Binding="{Binding Selected,UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Specification" Binding="{Binding Material.Specification}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Grade" Binding="{Binding Material.Grade}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Condition" Binding="{Binding Material.Condition}" IsReadOnly="True" />
                            <DataGridTextColumn Header="UNS" Binding="{Binding Material.UNS}" IsReadOnly="True" />
                            <DataGridTextColumn Header="MAIN composition" Binding="{Binding Material.NominalComposition}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Match evidence / conflicts" Binding="{Binding Reason}" IsReadOnly="True" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
