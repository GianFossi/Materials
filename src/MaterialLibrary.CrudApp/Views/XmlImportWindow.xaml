<Window x:Class="MaterialLibraryCrudApp.Views.XmlImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Importa XML — associazioni e anteprima" Width="1450" Height="950" MinWidth="1100" MinHeight="750">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Proprietà fisiche ed External Pressure — importazione XML" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="Scegli cartella…" Command="{Binding PickFolderCommand}" Padding="12,5"/><Button DockPanel.Dock="Right" Content="Leggi XML" Command="{Binding ScanCommand}" Padding="12,5" Margin="6,0"/><TextBox Text="{Binding Folder,UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
   <TextBlock Text="{Binding Diagnostic}" TextWrapping="Wrap" Foreground="#9A3412" Margin="0,8"/>
  </StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8"/>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding PropertyCode}" FontWeight="Bold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/><TextBlock Text="{Binding Key}" FontSize="10" Foreground="Gray" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="280"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
     <WrapPanel Margin="0,0,0,8"><TextBlock Text="Famiglia" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding PropertyCode}" Width="170" Margin="6,0"/><TextBlock Text="{Binding Unit}" VerticalAlignment="Center"/><CheckBox Content="Costante densità/Nu" IsChecked="{Binding IsConstant}" Margin="14,0" VerticalAlignment="Center"/></WrapPanel>
     <WrapPanel Margin="0,0,0,8"><TextBlock Text="Composizione del record" VerticalAlignment="Center"/><TextBox Text="{Binding SourceComposition,UpdateSourceTrigger=PropertyChanged}" Width="190" Margin="6,0"/><TextBlock Text="UNS" VerticalAlignment="Center"/><TextBox Text="{Binding SourceUns,UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="6,0"/><TextBlock Text="Chart" VerticalAlignment="Center"/><TextBox Text="{Binding ChartName,UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="6,0"/></WrapPanel>
     <WrapPanel><Button Content="Trova associazioni" Command="{Binding MatchCommand}" Padding="10,5" Margin="0,0,6,0"/><Button Content="Seleziona univoche" Command="{Binding SelectAutomaticCommand}" Padding="10,5" Margin="0,0,6,0"/><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged,Delay=300}" Width="230" ToolTip="Cerca materiale, composizione o motivazione"/></WrapPanel>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TabControl><TabItem Header="Dati numerici modificabili"><DockPanel><Button DockPanel.Dock="Bottom" Content="Aggiorna anteprima" Command="{Binding PreviewCommand}" Padding="10,5"/><TextBox Text="{Binding NumericText,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" ToolTip="T valore (SI) oppure T A B per EP. Separatore tab, spazio o punto e virgola; decimali con punto."/></DockPanel></TabItem><TabItem Header="Testo/XML originale"><TextBox Text="{Binding SourceText,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas"/></TabItem></TabControl>
     <DockPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock DockPanel.Dock="Top" Text="Anteprima: blu = XML, grigio = database. EP: asse A logaritmico; linee separate per temperatura." TextWrapping="Wrap"/><TextBlock x:Name="PlotLegend" DockPanel.Dock="Bottom" FontSize="11" TextWrapping="Wrap"/><Canvas x:Name="Plot" Background="#F4F7FB" ClipToBounds="True" SizeChanged="Plot_SizeChanged"/></DockPanel>
    </Grid>
    <DockPanel Grid.Row="2">
     <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><CheckBox Content="Ho verificato record, unità, note, curve ed eventuali esponenti PDF" IsChecked="{Binding Reviewed}"/><CheckBox Content="Sostituisci esplicitamente i dati già presenti della stessa famiglia / associazione chart" IsChecked="{Binding ReplaceExisting}" Margin="0,5"/><Button Content="Importa associazioni selezionate…" Command="{Binding ImportCommand}" HorizontalAlignment="Left" Padding="16,7"/></StackPanel>
     <DataGrid ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
      <DataGrid.Columns><DataGridCheckBoxColumn Header="Importa" Binding="{Binding Selected,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Score" Binding="{Binding Score}" IsReadOnly="True"/><DataGridTextColumn Header="Specification" Binding="{Binding Material.Specification}" IsReadOnly="True"/><DataGridTextColumn Header="Grade" Binding="{Binding Material.Grade}" IsReadOnly="True"/><DataGridTextColumn Header="Condition" Binding="{Binding Material.Condition}" IsReadOnly="True"/><DataGridTextColumn Header="UNS" Binding="{Binding Material.UNS}" IsReadOnly="True"/><DataGridTextColumn Header="Composizione MAIN" Binding="{Binding Material.NominalComposition}" IsReadOnly="True"/><DataGridTextColumn Header="Motivazione / conflitti" Binding="{Binding Reason}" IsReadOnly="True" Width="*"/></DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
