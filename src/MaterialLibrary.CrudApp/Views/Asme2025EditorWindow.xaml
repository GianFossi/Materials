<Window x:Class="MaterialLibraryCrudApp.Views.Asme2025EditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ASME 2025 — Material Properties" Width="1250" Height="850" MinWidth="950" MinHeight="650">
 <DockPanel Margin="12">
  <Button DockPanel.Dock="Top" Content="Import properties / charts from XML..." Command="{Binding ImportXmlCommand}" HorizontalAlignment="Right" Padding="12,6" Margin="0,0,0,8" ToolTip="Scan configured XML folders, review candidate property data, and explicitly select the material records to import."/>
  <TextBlock DockPanel.Dock="Top" Text="ASME 2025 · edit the working copy" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
  <TextBlock DockPanel.Dock="Top" Text="Choose a material and property family, then select or edit a size-specific curve. Changes are saved to the working database; original ASME source notes remain read-only." TextWrapping="Wrap" Foreground="#52616F" Margin="0,0,0,8"/>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel Grid.Column="0">
    <TextBox DockPanel.Dock="Top" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter materials by specification, grade, class/condition/temper, or UNS. Separate search terms narrow the results." Margin="0,0,0,8"/>
    <ListBox ItemsSource="{Binding MaterialView}" SelectedItem="{Binding SelectedMaterial}">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3"><TextBlock><Run Text="{Binding Specification}"/><Run Text=" "/><Run Text="{Binding Grade}"/></TextBlock><TextBlock FontSize="11" Foreground="Gray"><Run Text="{Binding Condition}"/><Run Text=" · "/><Run Text="{Binding UNS}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <TabControl Grid.Column="2">
   <TabItem Header="Property Curves">
     <DockPanel Margin="8">
      <StackPanel DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="Property family" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding AvailableFamilies}" SelectedItem="{Binding Family}" Width="120" Margin="10,0" ToolTip="Choose the property family to view or edit. Bolting and non-bolting families are filtered when the source data identifies the applicable group."/><TextBlock Text="{Binding Unit}" VerticalAlignment="Center"/></StackPanel>
      <ComboBox ItemsSource="{Binding Curves}" SelectedItem="{Binding SelectedCurve}" MinHeight="58" MaxDropDownHeight="420" Margin="0,0,0,8" ToolTip="Select a curve variant. Labels show product form, stress level, size range, source table, and point count.">
        <ComboBox.ItemTemplate>
         <DataTemplate>
          <StackPanel Margin="4,3">
           <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding SizeRangeLabel}" FontSize="11" Foreground="#52616F" TextWrapping="Wrap"/>
           <TextBlock Text="{Binding SourceLabel}" FontSize="11" Foreground="#52616F"/>
          </StackPanel>
         </DataTemplate>
        </ComboBox.ItemTemplate>
       </ComboBox>
       <WrapPanel Margin="0,0,0,8"><Button Content="New curve" Command="{Binding NewCurveCommand}" Padding="10,5" Margin="0,0,6,0" ToolTip="Create a new curve variant for the selected material and property family."/><Button Content="Save curve" Command="{Binding SaveCurveCommand}" Padding="10,5" Margin="0,0,6,0" ToolTip="Validate and save this variant, its size range, stress classification, notes, and temperature/value points."/><Button Content="Delete curve" Command="{Binding DeleteCurveCommand}" Padding="10,5" Margin="0,0,6,0" ToolTip="Delete the selected curve and its points after confirmation."/><Button Content="Reload" Command="{Binding ReloadCommand}" Padding="10,5" ToolTip="Discard unsaved edits and reload this property family from the working database."/></WrapPanel>
       <WrapPanel IsEnabled="{Binding IsMechanical}" Margin="0,0,0,8">
        <TextBlock Text="Product form" VerticalAlignment="Center"/><ComboBox Width="160" ItemsSource="{Binding ProductFormChoices}" SelectedItem="{Binding ProductForm,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditForm}" Margin="5,0,12,0" ToolTip="Select the product form for this S1/S2 curve. Manage the available choices in Options."/>
        <TextBlock Text="Min (mm)" VerticalAlignment="Center"/><TextBox Width="65" Text="{Binding SizeMinimum,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Margin="5,0" ToolTip="Inclusive or exclusive lower size boundary in millimetres; leave blank for no lower limit."/><CheckBox Content="Inclusive" IsChecked="{Binding MinimumIncluded}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Include values exactly equal to the minimum size boundary."/>
        <TextBlock Text="Max (mm)" VerticalAlignment="Center"/><TextBox Width="65" Text="{Binding SizeMaximum,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Margin="5,0" ToolTip="Inclusive or exclusive upper size boundary in millimetres; leave blank for no upper limit."/><CheckBox Content="Inclusive" IsChecked="{Binding MaximumIncluded}" VerticalAlignment="Center" ToolTip="Include values exactly equal to the maximum size boundary."/>
        <TextBlock Text="Size axis" VerticalAlignment="Center" Margin="12,0,4,0"/><ComboBox Width="140" SelectedValue="{Binding SizeAxis}" SelectedValuePath="Content" ToolTip="Specify which dimension the size limits refer to."><ComboBoxItem Content="thickness-or-unspecified"/><ComboBoxItem Content="diameter"/><ComboBoxItem Content="OD"/><ComboBoxItem Content="DN"/></ComboBox>
       </WrapPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowS1StressLevel}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="S1 stress level" VerticalAlignment="Center"/>
        <ComboBox SelectedValue="{Binding S1StressLevel}" SelectedValuePath="Tag" Width="235" Margin="8,0" ToolTip="Identify the S1 category. High Stress applies when the ASME G5 note is applicable; otherwise select Normal Stress.">
         <ComboBoxItem Content="Normal Stress (no G5)" Tag="Normal"/>
         <ComboBoxItem Content="High Stress (G5 note)" Tag="High"/>
        </ComboBox>
       </StackPanel>
       <Border Padding="8" Margin="0,0,0,8" Background="#FFF4DD" BorderBrush="#E0BE70" BorderThickness="1" CornerRadius="3">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowJointEfficiency}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <TextBlock Text="{Binding JointEfficiencySummary}" TextWrapping="Wrap"/>
       </Border>
       <TextBlock Text="Create a separate curve for each product-form and size-range variant. Temperatures are in °C; stress and elastic modulus values use the unit shown above. Original ASME notes are preserved." TextWrapping="Wrap" Foreground="#52616F" Margin="0,0,0,8"/>
      </StackPanel>
      <Grid>
       <Grid.RowDefinitions>       <RowDefinition Height="*"/><RowDefinition Height="280"/></Grid.RowDefinitions>
       <DataGrid x:Name="PointGrid" ItemsSource="{Binding Points}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" RowEditEnding="PointGrid_RowEditEnding" ToolTip="Edit temperature/value pairs. Use the new-row placeholder to add points and select a row before pressing Delete to remove it.">
        <DataGrid.Columns><DataGridTextColumn Header="Temperature (°C)" Binding="{Binding Temperature,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Width="*"/><DataGridTextColumn Header="Value (unit shown above)" Binding="{Binding Value,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Width="*"/></DataGrid.Columns>
       </DataGrid>
       <TabControl x:Name="CurveDetailTabs" Grid.Row="1" Margin="0,8,0,0">
        <TabItem Header="Original ASME Notes" ToolTip="General and specific ASME notes linked to this curve. Editing is optional and stays local to this curve.">
         <DockPanel Margin="6">
          <TextBlock DockPanel.Dock="Top" Text="{Binding SourceNoteOrigin}" TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,6"/>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
           <CheckBox Content="Allow edit" IsChecked="{Binding AllowSourceNoteEdit}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Unlock the note rows and the Add, Copy and Delete buttons. Changes are saved with the curve as a curve-level copy; the official ASME note tables are never modified."/>
           <ComboBox ItemsSource="{Binding CommonNotes}" SelectedItem="{Binding SelectedCommonNote}" DisplayMemberPath="Label" TextSearch.TextPath="Label" Width="350" IsTextSearchEnabled="True" MaxDropDownHeight="300" IsEnabled="{Binding AllowSourceNoteEdit}" ToolTip="ASME notes of the tables relevant to this property family. Select one, then press Copy to add it to this curve.">
            <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="ToolTip" Value="{Binding Text}"/></Style></ComboBox.ItemContainerStyle>
           </ComboBox>
           <Button Content="Add" Command="{Binding AddNoteCommand}" Margin="6,0,0,0" Padding="10,3" ToolTip="Add a blank note row to this curve. Requires Allow edit."/>
           <Button Content="Copy" Command="{Binding CopyCommonNoteCommand}" Margin="6,0,0,0" Padding="10,3" ToolTip="Copy the ASME note selected in the dropdown into this curve's note rows. Requires Allow edit."/>
           <Button Content="Delete" Command="{Binding DeleteNoteCommand}" Margin="6,0,0,0" Padding="10,3" ToolTip="Remove the selected note row from this curve only. Requires Allow edit and a selected row."/>
          </WrapPanel>
          <DataGrid x:Name="SourceNotesGrid" ItemsSource="{Binding SourceNoteRows}" SelectedItem="{Binding SelectedSourceNoteRow}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="{Binding SourceNotesReadOnly}" RowEditEnding="SourceNotesGrid_RowEditEnding" ToolTip="Notes that apply to this curve. Check Allow edit to change the table, code or text of a row.">
           <DataGrid.Columns>
            <DataGridTextColumn Header="Source table" Binding="{Binding SourceTable,UpdateSourceTrigger=PropertyChanged}" Width="90"/>
            <DataGridTextColumn Header="Code" Binding="{Binding Code,UpdateSourceTrigger=PropertyChanged}" Width="75"/>
            <DataGridTextColumn Header="Note text" Binding="{Binding Text,UpdateSourceTrigger=PropertyChanged}" Width="*">
             <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
             <DataGridTextColumn.EditingElementStyle><Style TargetType="TextBox"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="AcceptsReturn" Value="True"/></Style></DataGridTextColumn.EditingElementStyle>
            </DataGridTextColumn>
           </DataGrid.Columns>
          </DataGrid>
         </DockPanel>
        </TabItem>
        <TabItem Header="User Notes" ToolTip="Free-text notes for this curve, saved with the curve.">
         <DockPanel Margin="6">
          <TextBlock DockPanel.Dock="Top" Text="Write any free-text comment about this curve (review status, design assumptions, references). It is saved with the curve and kept separate from the ASME notes." TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,6"/>
          <TextBox Text="{Binding UserNotesText,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="Free-text user notes for this curve. Press Save curve to store them."/>
         </DockPanel>
        </TabItem>
        <TabItem Header="ASME Code Limits" ToolTip="Welding P-No./Group No., external-pressure chart and maximum temperature limits by ASME Section for this curve.">
         <TabItem.Style><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowCodeLimits}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TabItem.Style>
         <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6">
           <TextBlock Text="Values from this curve's own ASME Section II-D table row (each product form or size variant can differ). Temperatures are in °C. Enter NP when the material is not permitted for that Section, and leave a field blank when the source table has no such column. Edits are saved with the curve; restoring the source values removes the edit." TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,8"/>
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="P-No. (welding)" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox Grid.Column="1" Text="{Binding PNumber,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" ToolTip="ASME Section IX P-Number used for welding procedure and welder qualification grouping, for example 1, 5A or 8."/>
            <TextBlock Grid.Column="3" Text="Max temp. Section I (°C)" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox Grid.Column="4" Text="{Binding MaxTempSectionI,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" ToolTip="Section I (power boilers) applicability and maximum temperature in °C: a number, NP if not permitted, or blank."/>
            <TextBlock Grid.Row="1" Text="Group No. (welding)" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GroupNumber,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" ToolTip="ASME Section IX Group Number within the P-Number (impact-test grouping), for example 1 or 2. Blank when the source does not assign one."/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="Max temp. Section III (°C)" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding MaxTempSectionIII,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" ToolTip="Section III (nuclear) applicability and maximum temperature in °C. A qualifier in parentheses is allowed, for example 204 (Cl. 3 only)."/>
            <TextBlock Grid.Row="2" Text="External-pressure chart" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ExternalPressureChart,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" ToolTip="Section II-D Subpart 3 external-pressure chart designation, for example CS–2 or HA–1."/>
            <TextBlock Grid.Row="2" Grid.Column="3" Text="Max temp. Section VIII-1 (°C)" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding MaxTempSectionVIII1,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" ToolTip="Section VIII Division 1 applicability and maximum temperature in °C: a number, NP if not permitted, or blank. Used as the maximum temperature of S1 and Sb1 datasets."/>
            <TextBlock Grid.Row="3" Grid.Column="3" Text="Max temp. Section VIII-2 (°C)" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding MaxTempSectionVIII2,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" ToolTip="Section VIII Division 2 applicability and maximum temperature in °C: a number, NP if not permitted, or blank. Used as the maximum temperature of S2 and Sb2 datasets."/>
            <TextBlock Grid.Row="4" Grid.Column="3" Text="Max temp. Section XII (°C)" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding MaxTempSectionXII,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" ToolTip="Section XII (transport tanks) applicability and maximum temperature in °C: a number, NP if not permitted, or blank."/>
           </Grid>
          </StackPanel>
         </ScrollViewer>
        </TabItem>
       </TabControl>
      </Grid>
     </DockPanel>
    </TabItem>
    <TabItem Header="Physical Constants"><StackPanel Margin="16">
     <TextBlock Text="Leave a field blank when the material source does not provide a constant value. Temperature-dependent data belongs in the property curves." TextWrapping="Wrap" Margin="0,0,0,16"/>
     <TextBlock Text="Constant density (kg/m³)"/><TextBox Text="{Binding ConstantDensity,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Margin="0,4,0,12" ToolTip="Material density in kilograms per cubic metre, when represented by a single constant value."/>
     <TextBlock Text="Constant Poisson ratio (dimensionless)"/><TextBox Text="{Binding ConstantNu,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Margin="0,4,0,12" ToolTip="Dimensionless Poisson ratio when represented by a single constant value."/>
     <Button Content="Save constants" Command="{Binding SaveConstantsCommand}" HorizontalAlignment="Left" Padding="12,6" ToolTip="Save the density and Poisson ratio. Blank fields are stored as unavailable (NULL)."/>
    </StackPanel></TabItem>
    <TabItem Header="MAIN Identity"><StackPanel Margin="16">
     <TextBlock Text="A MAIN identity is unique by Specification + Grade + Class/Condition/Temper + UNS. Save identity changes separately from curve changes." TextWrapping="Wrap" Margin="0,0,0,12"/>
     <TextBlock Text="Specification"/><TextBox Text="{Binding Specification,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" ToolTip="Governing material specification, such as SA-516."/>
     <TextBlock Text="Grade"/><TextBox Text="{Binding Grade,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" ToolTip="Grade or class designation within the specification."/>
     <TextBlock Text="Class / Condition / Temper"/><TextBox Text="{Binding Condition,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" ToolTip="Additional designation that distinguishes heat treatment, condition, class, or temper."/>
     <TextBlock Text="UNS"/><TextBox Text="{Binding Uns,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" ToolTip="Unified Numbering System alloy identifier, if available."/>
     <TextBlock Text="Nominal composition"/><TextBox Text="{Binding Composition,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,12" ToolTip="Nominal composition used for identification and XML matching."/>
     <WrapPanel><Button Content="New material identity" Command="{Binding NewIdentityCommand}" Padding="12,6" Margin="0,0,8,0" ToolTip="Clear the identity fields and prepare a new MAIN material record."/><Button Content="Save identity" Command="{Binding SaveIdentityCommand}" Padding="12,6" ToolTip="Save the MAIN identity. The specification/grade/condition/UNS combination must be unique."/></WrapPanel>
    </StackPanel></TabItem>
   </TabControl>
  </Grid>
 </DockPanel>
</Window>
