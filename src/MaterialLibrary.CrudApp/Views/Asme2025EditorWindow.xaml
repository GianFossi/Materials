<Window x:Class="MaterialLibraryCrudApp.Views.Asme2025EditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ASME 2025 — Proprietà dei materiali" Width="1250" Height="850" MinWidth="950" MinHeight="650">
 <DockPanel Margin="12">
  <TextBlock DockPanel.Dock="Top" Text="ASME 2025 · modifica della copia di lavoro" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel Grid.Column="0">
    <TextBox DockPanel.Dock="Top" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="Cerca Specification, Grade, Condition o UNS" Margin="0,0,0,8"/>
    <ListBox ItemsSource="{Binding MaterialView}" SelectedItem="{Binding SelectedMaterial}">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3"><TextBlock><Run Text="{Binding Specification}"/><Run Text=" "/><Run Text="{Binding Grade}"/></TextBlock><TextBlock FontSize="11" Foreground="Gray"><Run Text="{Binding Condition}"/><Run Text=" · "/><Run Text="{Binding UNS}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <TabControl Grid.Column="2">
    <TabItem Header="Curve delle proprietà">
     <DockPanel Margin="8">
      <StackPanel DockPanel.Dock="Top">
       <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="Proprietà" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding Family}" Width="120" Margin="10,0"/><TextBlock Text="{Binding Unit}" VerticalAlignment="Center"/></StackPanel>
       <ComboBox ItemsSource="{Binding Curves}" SelectedItem="{Binding SelectedCurve}" DisplayMemberPath="Label" Margin="0,0,0,8"/>
       <WrapPanel Margin="0,0,0,8"><Button Content="Nuova curva" Command="{Binding NewCurveCommand}" Padding="10,5" Margin="0,0,6,0"/><Button Content="Salva curva" Command="{Binding SaveCurveCommand}" Padding="10,5" Margin="0,0,6,0"/><Button Content="Elimina curva" Command="{Binding DeleteCurveCommand}" Padding="10,5" Margin="0,0,6,0"/><Button Content="Ricarica" Command="{Binding ReloadCommand}" Padding="10,5"/></WrapPanel>
       <WrapPanel IsEnabled="{Binding IsMechanical}" Margin="0,0,0,8">
        <TextBlock Text="Product form" VerticalAlignment="Center"/><TextBox Width="110" Text="{Binding ProductForm,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditForm}" Margin="5,0,12,0"/>
        <TextBlock Text="Min mm" VerticalAlignment="Center"/><TextBox Width="65" Text="{Binding SizeMinimum,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Margin="5,0"/><CheckBox Content="incluso" IsChecked="{Binding MinimumIncluded}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock Text="Max mm" VerticalAlignment="Center"/><TextBox Width="65" Text="{Binding SizeMaximum,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Margin="5,0"/><CheckBox Content="incluso" IsChecked="{Binding MaximumIncluded}" VerticalAlignment="Center"/>
        <TextBlock Text="Asse" VerticalAlignment="Center" Margin="12,0,4,0"/><ComboBox Width="140" SelectedValue="{Binding SizeAxis}" SelectedValuePath="Content"><ComboBoxItem Content="thickness-or-unspecified"/><ComboBoxItem Content="diameter"/><ComboBoxItem Content="OD"/><ComboBoxItem Content="DN"/></ComboBox>
       </WrapPanel>
       <TextBlock Text="Una curva per variante. Tensioni e modulo E in MPa; temperatura in °C. Le note ASME originali restano conservate." TextWrapping="Wrap" Foreground="#52616F" Margin="0,0,0,8"/>
      </StackPanel>
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions>
       <DataGrid x:Name="PointGrid" ItemsSource="{Binding Points}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" RowEditEnding="PointGrid_RowEditEnding">
        <DataGrid.Columns><DataGridTextColumn Header="Temperatura (°C)" Binding="{Binding Temperature,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Width="*"/><DataGridTextColumn Header="Valore (unità indicata sopra)" Binding="{Binding Value,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Width="*"/></DataGrid.Columns>
       </DataGrid>
       <TabControl Grid.Row="1" Margin="0,8,0,0">
        <TabItem Header="Note ASME originali"><TextBox Text="{Binding SourceNotes,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
        <TabItem Header="Note dell’utente"><TextBox Text="{Binding UserNotes,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
       </TabControl>
      </Grid>
     </DockPanel>
    </TabItem>
    <TabItem Header="Costanti fisiche"><StackPanel Margin="16">
     <TextBlock Text="Lascia vuoto per indicare un valore non disponibile." Margin="0,0,0,16"/>
     <TextBlock Text="Densità costante (kg/m³)"/><TextBox Text="{Binding ConstantDensity,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Margin="0,4,0,12"/>
     <TextBlock Text="Coefficiente di Poisson costante (adimensionale)"/><TextBox Text="{Binding ConstantNu,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Margin="0,4,0,12"/>
     <Button Content="Salva costanti" Command="{Binding SaveConstantsCommand}" HorizontalAlignment="Left" Padding="12,6"/>
    </StackPanel></TabItem>
    <TabItem Header="Identità MAIN"><StackPanel Margin="16">
     <TextBlock Text="Univocità: Specification + Grade + Class/Condition/Temper + UNS" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <TextBlock Text="Specification"/><TextBox Text="{Binding Specification,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
     <TextBlock Text="Grade"/><TextBox Text="{Binding Grade,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
     <TextBlock Text="Class / Condition / Temper"/><TextBox Text="{Binding Condition,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
     <TextBlock Text="UNS"/><TextBox Text="{Binding Uns,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
     <TextBlock Text="Nominal composition"/><TextBox Text="{Binding Composition,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,12"/>
     <WrapPanel><Button Content="Nuovo materiale" Command="{Binding NewIdentityCommand}" Padding="12,6" Margin="0,0,8,0"/><Button Content="Salva identità" Command="{Binding SaveIdentityCommand}" Padding="12,6"/></WrapPanel>
    </StackPanel></TabItem>
   </TabControl>
  </Grid>
 </DockPanel>
</Window>
