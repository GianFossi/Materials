<Window x:Class="MaterialLibraryCrudApp.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Options"
        Width="700"
        Height="650"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top"
                   Text="Configure reusable product forms, the default welded-joint efficiency, and the locations used by file pickers."
                   TextWrapping="Wrap"
                   Foreground="#52616F"
                   Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save"
                        Click="Save_Click"
                        IsDefault="True"
                        Padding="14,6"
                        ToolTip="Validate and write these preferences to the application options XML file." />
                <Button Content="Cancel"
                        IsCancel="True"
                        Margin="8,0,0,0"
                        Padding="14,6"
                        ToolTip="Close without applying the edits in this window." />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Product forms" Margin="0,0,0,10">
                    <DockPanel Margin="8">
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBox Width="390"
                                     Text="{Binding NewProductForm, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Type the label to offer in the Product form dropdowns." />
                            <Button Content="Add"
                                    Command="{Binding AddProductFormCommand}"
                                    Margin="8,0,0,0"
                                    Padding="10,3"
                                    ToolTip="Add the typed product form to the selectable list." />
                            <Button Content="Remove selected"
                                    Command="{Binding RemoveProductFormCommand}"
                                    Margin="8,0,0,0"
                                    Padding="10,3"
                                    ToolTip="Remove the selected form from future dropdown choices." />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Select a row to remove it. Existing material values remain unchanged if a form is removed."
                                   TextWrapping="Wrap"
                                   Foreground="#52616F"
                                   Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding ProductForms}"
                                 SelectedItem="{Binding SelectedProductForm}"
                                 MinHeight="130"
                                 ToolTip="Product-form values available in material and ASME curve editors." />
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="Welded-joint efficiency" Margin="0,0,0,10">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Default efficiency (joint)"
                                   VerticalAlignment="Center"
                                   ToolTip="Reference efficiency for the longitudinal joint, or the joint most highly stressed by pressure, when no explicit value is found in the ASME notes." />
                        <TextBox Grid.Column="1"
                                 Width="120"
                                 HorizontalAlignment="Left"
                                 Text="{Binding DefaultJointEfficiency, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Enter a fraction greater than 0 and no greater than 1 for the longitudinal or pressure-critical joint. The typical default is 0.70." />
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Text="This reference is for the longitudinal or pressure-critical joint. Always verify the applicable ASME notes and design conditions."
                                   TextWrapping="Wrap"
                                   Foreground="#52616F"
                                   Margin="0,8,0,0" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Default import and database locations">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Flex/property XML folder"
                                   VerticalAlignment="Center"
                                   ToolTip="Starting folder for XML property and external-pressure imports." />
                        <TextBox Grid.Column="1"
                                 Text="{Binding FlexXmlFolder, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,6,0"
                                 ToolTip="Folder to preselect when browsing for flex/property XML data." />
                        <Button Grid.Column="2"
                                Content="Browse..."
                                Click="BrowseFlexFolder_Click"
                                ToolTip="Choose the default folder containing flex/property XML files." />
                        <TextBlock Grid.Row="2"
                                   Text="SQLite database file"
                                   VerticalAlignment="Center"
                                   Margin="0,10,0,0"
                                   ToolTip="Database file preselected by the database open dialog." />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding DatabaseFilePath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,10,6,0"
                                 ToolTip="Full path to the default .db or .sqlite file." />
                        <Button Grid.Row="2"
                                Grid.Column="2"
                                Content="Browse..."
                                Margin="0,10,0,0"
                                Click="BrowseDatabaseFile_Click"
                                ToolTip="Choose the default SQLite database file." />
                        <TextBlock Grid.Row="3"
                                   Grid.ColumnSpan="3"
                                   Text="Blank paths leave the file dialogs at their normal starting location."
                                   TextWrapping="Wrap"
                                   Foreground="#52616F"
                                   Margin="0,8,0,0" />
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
