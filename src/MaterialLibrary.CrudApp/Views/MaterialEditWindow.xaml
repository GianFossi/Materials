<Window x:Class="MaterialLibraryCrudApp.Views.MaterialEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MaterialLibraryCrudApp.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MaterialEditViewModel}"
        Title="{Binding Title}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            UpdateSourceTrigger=PropertyChanged keeps the view model in step with every keystroke,
            so validation on OK never reads a stale buffer.
        -->

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Id *" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Grid.Row="0" Grid.Column="1"
                 Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsIdEditable}"
                 Style="{StaticResource FieldInputStyle}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Specification" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding Specification, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FieldInputStyle}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Grade" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Grid.Row="2" Grid.Column="1"
                 Text="{Binding Grade, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FieldInputStyle}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Product form" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Grid.Row="3" Grid.Column="1"
                 Text="{Binding ProductForm, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FieldInputStyle}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Nominal composition" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Grid.Row="4" Grid.Column="1"
                 Text="{Binding NominalComposition, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FieldInputStyle}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Class/Condition/Tempering" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Grid.Row="5" Grid.Column="1"
                 Text="{Binding ClassConditionTempering, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FieldInputStyle}" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Alloy (UNS)" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Grid.Row="6" Grid.Column="1"
                 Text="{Binding AlloyIdentificationUns, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FieldInputStyle}" />

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Family (ASME)" Style="{StaticResource FieldLabelStyle}" />
        <ComboBox Grid.Row="7" Grid.Column="1"
                  Margin="4"
                  Padding="4,2"
                  ItemsSource="{Binding FamilyChoices}"
                  SelectedItem="{Binding SelectedFamily, Mode=TwoWay}"
                  DisplayMemberPath="Display" />

        <Separator Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="4,8" />

        <!--
            Everything in this block comes from the room-temperature tensile coupon test, and only
            from it. The temperature-dependent minimum strengths Sy(T) and Su(T) vary with section
            size and are edited in the tables window, not here.
        -->
        <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="Room-temperature tensile test"
                   FontWeight="Bold"
                   Margin="4,4,4,2" />

        <TextBlock Grid.Row="10" Grid.Column="0" Text="Elongation, longitudinal (%)" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Grid.Row="10" Grid.Column="1"
                 Text="{Binding ElongationLongitudinalPercent, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Leave blank when the source does not report this direction."
                 Style="{StaticResource FieldInputStyle}" />

        <TextBlock Grid.Row="11" Grid.Column="0" Text="Elongation, transverse (%)" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Grid.Row="11" Grid.Column="1"
                 Text="{Binding ElongationTransversePercent, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Leave blank when the source does not report this direction."
                 Style="{StaticResource FieldInputStyle}" />

        <TextBlock Grid.Row="12" Grid.Column="0" Text="Reduction of area (%)" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Grid.Row="12" Grid.Column="1"
                 Text="{Binding ReductionOfAreaPercent, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FieldInputStyle}" />

        <TextBlock Grid.Row="13" Grid.Column="0" Text="SMYS (MPa)" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Grid.Row="13" Grid.Column="1"
                 Text="{Binding SpecifiedMinimumYieldStrength, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FieldInputStyle}" />

        <TextBlock Grid.Row="14" Grid.Column="0" Text="SMUTS (MPa)" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Grid.Row="14" Grid.Column="1"
                 Text="{Binding SpecifiedMinimumUltimateStrength, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FieldInputStyle}" />

        <TextBlock Grid.Row="15" Grid.Column="0" Text="Notes" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Grid.Row="15" Grid.Column="1"
                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FieldInputStyle}"
                 Height="64"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <!--
                OK is wired in code-behind rather than to a command: confirming the dialog has to
                set DialogResult, which is a property of this window and not view-model state.
            -->
            <Button Content="OK"
                    IsDefault="True"
                    Click="OnConfirm"
                    Style="{StaticResource DialogButtonStyle}" />
            <Button Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource DialogButtonStyle}" />
        </StackPanel>

    </Grid>
</Window>
