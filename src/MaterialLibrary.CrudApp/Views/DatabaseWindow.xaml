<Window x:Class="MaterialLibraryCrudApp.Views.DatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MaterialLibraryCrudApp.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DatabaseViewModel}"
        Title="Material Database"
        Width="900"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="8">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Open Database..."
                    Command="{Binding OpenDatabaseCommand}"
                    Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="Reopen Last"
                    Command="{Binding ReopenLastDatabaseCommand}"
                    Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource ToolbarButtonStyle}" />
            <Separator Margin="6,4" />
            <Button Content="Import to Library"
                    Command="{Binding ImportSelectedCommand}"
                    Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="Write Library to DB"
                    Command="{Binding ExportLibraryCommand}"
                    Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="Delete from DB"
                    Command="{Binding DeleteSelectedCommand}"
                    Style="{StaticResource ToolbarButtonStyle}" />
            <Separator Margin="6,4" />
            <Button Content="Save Working Copy As..."
                    Command="{Binding SaveWorkingCopyAsCommand}"
                    Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="Backup Working Copy"
                    Command="{Binding BackupWorkingCopyCommand}"
                    Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="Cancel"
                    Command="{Binding CancelOperationCommand}"
                    Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="Integrity Check"
                    Command="{Binding IntegrityCheckCommand}"
                    Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="Undo Last Transaction"
                    Command="{Binding UndoLastTransactionCommand}"
                    Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="Redo Last Transaction"
                    Command="{Binding RedoLastTransactionCommand}"
                    Style="{StaticResource ToolbarButtonStyle}" />
        </StackPanel>

        <!-- Makes it unmistakable that edits target a copy, never the file the user picked. -->
        <TextBlock DockPanel.Dock="Top"
                   Margin="4,0,4,6"
                   TextTrimming="CharacterEllipsis"
                   Foreground="#444">
            <Run Text="Working copy:" FontWeight="Bold" />
            <Run Text="{Binding WorkingPathDisplay, Mode=OneWay}" />
        </TextBlock>

        <TextBlock DockPanel.Dock="Top"
                   Margin="4,0,4,6"
                   Text="{Binding ReferenceModeDisplay}"
                   Foreground="#1D4ED8" />

        <TextBlock DockPanel.Dock="Top"
                   Text="Working..."
                   Foreground="#8A5A00"
                   Margin="4,0,4,6">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border DockPanel.Dock="Top"
                BorderBrush="#D6B656"
                BorderThickness="1"
                Background="#FFF8D8"
                Padding="8"
                Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap"
                       Foreground="#4A3B00">
                <Run Text="Important:" FontWeight="Bold" />
                <Run Text=" all changes still target the .working.db file only. Use " />
                <Run Text="Save Working Copy As..." FontWeight="Bold" />
                <Run Text=" when you want to persist/export that modified database." />
            </TextBlock>
        </Border>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="Close"
                    IsDefault="True"
                    IsCancel="True"
                    Style="{StaticResource DialogButtonStyle}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding StatusMessage}"
                   Margin="4,6"
                   TextWrapping="Wrap"
                   Foreground="#555" />

        <TabControl>
            <TabItem Header="Materials">
                <DataGrid ItemsSource="{Binding Materials}"
                          SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F7F7F7">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DB ID" Binding="{Binding DatabaseId}" Width="80" />
                        <DataGridTextColumn Header="Material key" Binding="{Binding MaterialKey}" Width="150" />
                        <DataGridTextColumn Header="Specification" Binding="{Binding Specification}" Width="150" />
                        <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="90" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Raw Tables">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,0,0,6">
                        <ComboBox ItemsSource="{Binding Tables}"
                                  SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Width="260"
                                  Margin="0,0,8,0" />
                        <TextBox Text="{Binding TableSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Width="150" ToolTip="Filter table names" Margin="0,0,8,0" />
                        <Button Content="Clear" Command="{Binding ClearTableToolsCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                        <Button Content="Refresh Table"
                                Command="{Binding RefreshTableCommand}"
                                Style="{StaticResource ToolbarButtonStyle}" />
                        <Button Content="Save Changes"
                                Command="{Binding SaveTableChangesCommand}"
                                Style="{StaticResource ToolbarButtonStyle}" />
                        <Button Content="Undo" Command="{Binding UndoTableCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                        <Button Content="Redo" Command="{Binding RedoTableCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                        <Button Content="Discard" Command="{Binding DiscardTableChangesCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                        <Button Content="Previous"
                                Command="{Binding PreviousTablePageCommand}"
                                Style="{StaticResource ToolbarButtonStyle}" />
                        <Button Content="Next"
                                Command="{Binding NextTablePageCommand}"
                                Style="{StaticResource ToolbarButtonStyle}" />
                        <TextBlock Text="Rows/page"
                                   VerticalAlignment="Center"
                                   Margin="12,0,4,0" />
                        <TextBox Text="{Binding TablePageSize, UpdateSourceTrigger=LostFocus}"
                                 Width="64"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Text="{Binding TablePageDisplay}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Foreground="#555" />
                    </StackPanel>

                    <Grid DockPanel.Dock="Bottom" Height="270" Margin="0,6,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Filter rows" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Text="{Binding RowFilter, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,8,0" />
                            <TextBlock Text="Sort" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox ItemsSource="{Binding TableColumns}" SelectedItem="{Binding SortColumn}" Width="140" Margin="0,0,4,0" />
                            <CheckBox Content="Descending" IsChecked="{Binding SortDescending}" VerticalAlignment="Center" />
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding TableSchema}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Column" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Type" Binding="{Binding DataType}" />
                                <DataGridTextColumn Header="Nullable" Binding="{Binding NullableDisplay}" />
                                <DataGridTextColumn Header="Primary key" Binding="{Binding PrimaryKeyDisplay}" />
                                <DataGridTextColumn Header="Default" Binding="{Binding DefaultValue}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <ListBox Grid.Row="2" ItemsSource="{Binding TableForeignKeys}" Height="55" Margin="0,4,0,0">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding FromColumn}" /><TextBlock Text=" -> " /><TextBlock Text="{Binding ReferencedTable}" /><TextBlock Text="." /><TextBlock Text="{Binding ToColumn}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <DataGrid ItemsSource="{Binding TableRows}"
                              AutoGenerateColumns="True"
                              AutoGeneratingColumn="RawTableGrid_AutoGeneratingColumn"
                              IsReadOnly="{Binding SelectedTable.IsReadOnly}"
                              CanUserAddRows="{Binding CanEditSelectedTable}"
                              CanUserDeleteRows="{Binding CanEditSelectedTable}"
                              SelectionMode="Extended"
                              SelectionUnit="CellOrRowHeader"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              GridLinesVisibility="All"
                              AlternatingRowBackground="#F7F7F7" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Create Table">
                <DockPanel Margin="6">
                    <Button DockPanel.Dock="Top"
                            HorizontalAlignment="Left"
                            Content="Create Table"
                            Command="{Binding CreateTableCommand}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,0,6" />
                    <TextBox Text="{Binding CreateTableSql, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             FontSize="13"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Schema">
                <StackPanel Margin="8">
                    <TextBlock Text="Rename selected table" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                        <TextBox Text="{Binding RenameTableName, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                        <Button Content="Rename" Command="{Binding RenameTableCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                    </StackPanel>
                    <TextBlock Text="Add column to selected table" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                        <TextBox Text="{Binding AddColumnSql, UpdateSourceTrigger=PropertyChanged}" Width="320" ToolTip="Example: NewValue REAL" />
                        <Button Content="Add column" Command="{Binding AddColumnCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                    </StackPanel>
                    <TextBlock Text="Create index SQL" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox Text="{Binding CreateIndexSql, UpdateSourceTrigger=PropertyChanged}" Width="420" ToolTip="Example: CREATE INDEX IX_Name ON Materials(Name)" />
                        <Button Content="Create index" Command="{Binding CreateIndexCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="SQL">
                <DockPanel Margin="6">
                    <Grid DockPanel.Dock="Top" Height="150" Margin="0,0,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button Content="Execute SQL"
                                Command="{Binding ExecuteSqlCommand}"
                                Style="{StaticResource ToolbarButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox Text="{Binding SavedQueryName, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="4,0" />
                            <Button Content="Save query" Command="{Binding SaveQueryCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="Load query" Command="{Binding LoadQueryCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="Export CSV" Command="{Binding ExportResultsCsvCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="Export JSON" Command="{Binding ExportResultsJsonCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="Export Excel" Command="{Binding ExportResultsExcelCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                        </StackPanel>
                        <TextBox Grid.Row="1"
                                 Text="{Binding SqlCommandText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </Grid>

                    <DataGrid ItemsSource="{Binding SqlResults}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              GridLinesVisibility="All"
                              AlternatingRowBackground="#F7F7F7" />
                    <ListBox DockPanel.Dock="Right" Width="180" ItemsSource="{Binding SqlHistory}" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Audit">
                <ListBox ItemsSource="{Binding AuditLog}" Margin="8" />
            </TabItem>

            <TabItem Header="Transactions">
                <DataGrid ItemsSource="{Binding TransactionHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time (UTC)" Binding="{Binding Timestamp}" Width="180" />
                        <DataGridTextColumn Header="Table" Binding="{Binding TableName}" Width="180" />
                        <DataGridTextColumn Header="Rows" Binding="{Binding Changes.Count}" Width="80" />
                        <DataGridTextColumn Header="Database" Binding="{Binding DatabasePath}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Plot">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,0,0,6">
                        <TextBox Text="{Binding PlotTitle, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,6,0" ToolTip="Plot title" />
                        <TextBox Text="{Binding PlotXAxisLabel, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,6,0" ToolTip="X axis label" />
                        <TextBox Text="{Binding PlotYAxisLabel, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,6,0" ToolTip="Y axis label" />
                        <ComboBox ItemsSource="{Binding Tables}"
                                  SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Width="220"
                                  Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding TableColumns}"
                                  SelectedItem="{Binding PlotXColumn, Mode=TwoWay}"
                                  Width="150"
                                  Margin="0,0,8,0" />
                        <TextBox Text="{Binding PlotYColumns, UpdateSourceTrigger=PropertyChanged}"
                                 Width="180" ToolTip="Y columns separated by commas" Margin="0,0,8,0" />
                        <Button Content="Plot"
                                Command="{Binding PlotTableCommand}"
                                Style="{StaticResource ToolbarButtonStyle}" />
                        <Button Content="Export PNG" Click="ExportPlotPng_Click" Style="{StaticResource ToolbarButtonStyle}" />
                        <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="8,0,4,0" />
                        <Slider Minimum="0.5" Maximum="3" Value="{Binding PlotZoom}" Width="90" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding PlotMessage}"
                               Margin="0,6,0,0"
                               Foreground="#555" />

                    <Border BorderBrush="#B8B8B8"
                            BorderThickness="1"
                            Background="White"
                            Padding="8">
                        <Viewbox Stretch="Uniform">
                            <Grid x:Name="PlotExportSurface" Width="760" Height="300" Background="White">
                              <Canvas x:Name="PlotCanvas" Width="680" Height="240" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0">
                                <Canvas.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding PlotZoom}" ScaleY="{Binding PlotZoom}" />
                                </Canvas.RenderTransform>
                                <TextBlock Text="{Binding PlotTitle}" Canvas.Left="18" Canvas.Top="4" FontWeight="Bold" />
                                <TextBlock Text="{Binding PlotXAxisLabel}" Canvas.Left="330" Canvas.Top="220" />
                                <TextBlock Text="{Binding PlotYAxisLabel}" Canvas.Left="0" Canvas.Top="18" />
                                <TextBlock Text="{Binding PlotYAxisMaximum}" Canvas.Left="28" Canvas.Top="18" Foreground="#666" FontSize="10" />
                                <TextBlock Text="{Binding PlotYAxisMinimum}" Canvas.Left="28" Canvas.Top="210" Foreground="#666" FontSize="10" />
                                <TextBlock Text="{Binding PlotXAxisMinimum}" Canvas.Left="18" Canvas.Top="224" Foreground="#666" FontSize="10" />
                                <TextBlock Text="{Binding PlotXAxisQuarter1}" Canvas.Left="170" Canvas.Top="224" Foreground="#666" FontSize="10" />
                                <TextBlock Text="{Binding PlotXAxisQuarter2}" Canvas.Left="325" Canvas.Top="224" Foreground="#666" FontSize="10" />
                                <TextBlock Text="{Binding PlotXAxisQuarter3}" Canvas.Left="480" Canvas.Top="224" Foreground="#666" FontSize="10" />
                                <TextBlock Text="{Binding PlotXAxisMaximum}" Canvas.Left="620" Canvas.Top="224" Foreground="#666" FontSize="10" />
                                <TextBlock Text="{Binding PlotYAxisQuarter1}" Canvas.Left="28" Canvas.Top="165" Foreground="#666" FontSize="10" />
                                <TextBlock Text="{Binding PlotYAxisQuarter2}" Canvas.Left="28" Canvas.Top="108" Foreground="#666" FontSize="10" />
                                <TextBlock Text="{Binding PlotYAxisQuarter3}" Canvas.Left="28" Canvas.Top="62" Foreground="#666" FontSize="10" />
                                <Line X1="179" Y1="18" X2="179" Y2="222" Stroke="#E5E7EB" />
                                <Line X1="340" Y1="18" X2="340" Y2="222" Stroke="#E5E7EB" />
                                <Line X1="501" Y1="18" X2="501" Y2="222" Stroke="#E5E7EB" />
                                <Line X1="18" Y1="171" X2="662" Y2="171" Stroke="#E5E7EB" />
                                <Line X1="18" Y1="120" X2="662" Y2="120" Stroke="#E5E7EB" />
                                <Line X1="18" Y1="69" X2="662" Y2="69" Stroke="#E5E7EB" />
                                <Line X1="18" Y1="222" X2="662" Y2="222" Stroke="#888" StrokeThickness="1" />
                                <Line X1="18" Y1="18" X2="18" Y2="222" Stroke="#888" StrokeThickness="1" />
                                <Canvas x:Name="PlotSeriesCanvas" Width="680" Height="240" IsHitTestVisible="False" />
                              </Canvas>
                              <ItemsControl x:Name="PlotExportLegend" ItemsSource="{Binding PlotSeries}" Margin="690,12,4,12" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Rectangle Width="14" Height="3" Fill="{Binding Stroke}" Margin="0,0,4,0" /><TextBlock Text="{Binding Name}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Grid>
                        </Viewbox>
                    </Border>
                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding PlotSeries}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Rectangle Width="14" Height="3" Fill="{Binding Stroke}" Margin="0,0,4,0" /><TextBlock Text="{Binding Name}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
