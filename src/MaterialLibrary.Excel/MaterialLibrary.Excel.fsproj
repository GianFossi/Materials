<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>MaterialLibrary.Excel</AssemblyName>
    <RootNamespace>MaterialLibrary.Excel</RootNamespace>
    <LangVersion>latest</LangVersion>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <Title>Material Library - Excel Add-In</Title>
    <Description>Excel-DNA add-in exposing MaterialLibrary material search, complete property tables, and temperature/size-interpolated property lookups as Excel worksheet functions.</Description>
    <Authors>Gian-Luca Brembana (Brembana &amp; Rolle S.p.A.)</Authors>
    <Platforms>x64;x86</Platforms>

    <!-- Excel-DNA requires the classic F# PackageReference opt-in; without it the
         ExcelDna.AddIn MSBuild targets refuse to run against an SDK-style F# project. -->
    <ExcelDnaAllowPackageReferenceProjectStyle>true</ExcelDnaAllowPackageReferenceProjectStyle>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LibraryCache.fs" />
    <Compile Include="ExcelHelpers.fs" />
    <Compile Include="ConfigurationFunctions.fs" />
    <Compile Include="InterpolationFunctions.fs" />
    <Compile Include="MaterialSearchFunctions.fs" />
    <Compile Include="MaterialPersistenceFunctions.fs" />
    <Compile Include="PhysicalPropertyFunctions.fs" />
    <Compile Include="StrengthPropertyFunctions.fs" />
    <Compile Include="AddIn.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MaterialLibrary\MaterialLibrary.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.301" />
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
  </ItemGroup>

</Project>
